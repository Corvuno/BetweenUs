{
  "promptSuggestionEnabled": false,
  "alwaysThinkingEnabled": true,
  "showThinkingSummaries": true,
  "permissions": {
    "allow": [
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(NODE_PATH=* node *)",
      "Bash(python3 *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(sed -n *)",
      "Bash(mkdir -p *)",
      "Artifact",
      "Agent",
      "SendUserFile"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/dont-guess.sh\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "designer-skills": {
      "source": {
        "source": "github",
        "repo": "Owl-Listener/designer-skills"
      }
    }
  },
  "enabledPlugins": {
    "ui-design@designer-skills": true,
    "interaction-design@designer-skills": true,
    "visual-critique@designer-skills": true,
    "cognitive-accessibility@designer-skills": true,
    "prototyping-testing@designer-skills": true
  }
}
