diff --git a/card.js b/card.js
index 7f15503..0998323 100644
--- a/card.js
+++ b/card.js
@@ -574,3 +574,85 @@ window.addEventListener('resize', () => {
 });
 
 
+
+/* ── CLEAR CORNERS (#111) ─────────────────────────────────────────────────────
+   No glyph of the question may enter the square at any of the card's four corners: each square is
+   the corner bracket's inset + the bracket + CORNER_CLEAR_MARGIN, measured from the card's corner
+   (the two corners without a bracket get the same square). A line that would enter one gets
+   shorter, equally on both sides so the text stays centred; the other lines keep the full width.
+   The browser breaks the lines itself: an empty span first in the question (styles.css
+   .corner-clear) holds two floats shaped to the two bands where the question meets the squares, and
+   this sets their size. The question sits in the middle of the card and its height depends on how
+   the lines break, so the bands are measured, applied, and measured again until they stop moving.
+   Font size and card size are never touched: if the shortened lines would not fit (the card would
+   scroll or grow), the question keeps its natural lines instead. Not used on the PC card
+   (its text already clears the corners) or the end-of-hand list. */
+const CORNER_CLEAR_MARGIN = 6;   // px past the end of the bracket
+const CORNER_CLEAR_PASSES = 6;
+const pcCardLayout = matchMedia('(min-width:900px) and (min-height:560px) and (min-aspect-ratio:5/4)');
+const clearMarker = Object.assign(document.createElement('span'), { className: 'corner-clear' });
+clearMarker.setAttribute('aria-hidden', 'true');
+
+/** The position of `el` inside `ancestor`, read from the layout (a transform in progress doesn't count). */
+function offsetWithin(el, ancestor) {
+  let x = 0, y = 0;
+  for (let n = el; n && n !== ancestor; n = n.offsetParent) { x += n.offsetLeft; y += n.offsetTop; }
+  return { x, y };
+}
+
+/** How far a box reaches into the four squares of side `side` on a card `card.w` x `card.h`: the heights of the
+ *  bands it shares with the top and the bottom squares, and the width it needs freed on each side. */
+function cornerReach(box, card, side) {
+  const within = v => Math.min(Math.max(v, 0), box.height);
+  const top = within(side - box.top), bottom = within(box.top + box.height - (card.h - side));
+  const width = Math.max(0, side - box.left, box.right - (card.w - side));
+  const band = v => (v > 0 ? Math.ceil(v) + 1 : 0);   // +1px so a line box that only touches a square still counts
+  return top + bottom > 0 ? { top: band(top), bottom: band(bottom), width: Math.ceil(width) } : { top: 0, bottom: 0, width: 0 };
+}
+
+function clearCornerSquares() {
+  const card = document.getElementById('card'), q = document.getElementById('card-question');
+  if (!card || !q) return;
+  const body = /** @type {HTMLElement} */ (q.parentElement);
+  const apply = ({ width = 0, top = 0, bottom = 0, height = 0 } = {}) => {
+    for (const [name, v] of Object.entries({ w: width, h: height, top, bottom })) q.style.setProperty(`--clear-${name}`, `${v}px`);
+  };
+  apply();
+  if (pcCardLayout.matches || card.classList.contains('is-hand-list')) return;
+  if (body.scrollHeight > body.clientHeight) return;   // already scrolling (a very long question): nothing to keep clear
+  const naturalCardHeight = card.offsetHeight;
+  const style = getComputedStyle(card);
+  const side = parseFloat(style.getPropertyValue('--bracket-inset')) + parseFloat(getComputedStyle(card, '::before').width) + CORNER_CLEAR_MARGIN;
+  const cardBox = { w: card.clientWidth, h: card.clientHeight };
+  let applied = { width: 0, top: 0, bottom: 0, height: 0 };
+  for (let pass = 0; pass < CORNER_CLEAR_PASSES; pass++) {
+    const { x, y } = offsetWithin(q, card);
+    const reach = cornerReach({ left: x, right: x + q.offsetWidth, top: y, height: q.offsetHeight }, cardBox, side);
+    const settled = reach.top === applied.top && reach.bottom === applied.bottom && reach.width === applied.width
+      && (reach.top + reach.bottom === 0 || q.offsetHeight === applied.height);
+    if (settled) break;
+    applied = { ...reach, height: q.offsetHeight };
+    apply(applied);
+  }
+  if (card.offsetHeight !== naturalCardHeight || body.scrollHeight > body.clientHeight) apply();   // the shorter lines don't fit: keep the natural ones
+}
+
+// The question's text is written from several places (card.js, deck.js, presentation.js), so watch it instead of hooking each.
+const questionWatcher = new MutationObserver(() => {
+  const q = document.getElementById('card-question');
+  if (q && q.firstChild !== clearMarker) q.prepend(clearMarker);
+  questionWatcher.takeRecords();
+  clearCornerSquares();
+});
+{
+  const q = document.getElementById('card-question');
+  if (q) {
+    questionWatcher.observe(q, { childList: true });
+    q.prepend(clearMarker);
+    questionWatcher.takeRecords();
+    clearCornerSquares();
+    new ResizeObserver(clearCornerSquares).observe(/** @type {HTMLElement} */ (document.getElementById('card')));
+    pcCardLayout.addEventListener('change', clearCornerSquares);
+    document.fonts?.addEventListener('loadingdone', clearCornerSquares);
+  }
+}
diff --git a/styles.css b/styles.css
index 325795e..32a10de 100644
--- a/styles.css
+++ b/styles.css
@@ -188,7 +188,7 @@ body{
   -webkit-touch-callout:none;touch-action:manipulation;
 }
 .card:active{transform:scale(.997);}
-.card{--bracket-inset:20px;--text-gap:6px;}   /* the question's side padding = bracket inset + gap, so it uses the width between the corner lines */
+.card{--bracket-inset:20px;--text-gap:11px;}   /* the question's side padding = bracket inset + gap (31px on a phone): it uses the width between the corner lines, with a margin (owner, 2026-11-05) */
 .card::before,.card::after{
   content:'';position:absolute;width:24px;height:24px;border-style:solid;z-index:2;
   border-color:var(--gold);opacity:.35;pointer-events:none;
@@ -314,6 +314,16 @@ body{
   cursor:text;
 }
 .card-question.in{opacity:1;transform:none;}
+/* Clear corners (#111): card.js puts this empty span first in the question and sets --clear-* on the question when a line
+   would reach into a corner square. The two pseudo-elements are floats that shorten the lines beside them by the same
+   amount on both sides; shape-outside leaves the gap between the top and bottom bands free, so only lines inside a band get
+   shorter. Without the variables both have no size and do nothing. */
+.corner-clear::before,.corner-clear::after{
+  content:'';width:var(--clear-w,0px);height:var(--clear-h,0px);
+  shape-outside:linear-gradient(#000 var(--clear-top,0px),transparent var(--clear-top,0px) calc(var(--clear-h,0px) - var(--clear-bottom,0px)),#000 calc(var(--clear-h,0px) - var(--clear-bottom,0px)));
+}
+.corner-clear::before{float:left;}
+.corner-clear::after{float:right;}
 /* The message after the last card of a hand: INTERMEZZO's lettering (Federo, spaced capitals, --muted-l) at its own size, centred on the card (both
    surfaces); it fades out before the card turns to Intermezzo. */
 .end-msg{display:block;font-family:'Federo',sans-serif;font-style:normal;font-size:1rem;letter-spacing:.32em;text-transform:uppercase;color:var(--muted-l);text-align:center;line-height:1.6;transition:opacity .45s ease;}
