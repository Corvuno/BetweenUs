#!/bin/sh
# Push lock: refuse a push to main while the static check has new findings (see CHECKS.md).
# git feeds one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
pushes_main=0
while read -r _ _ remote_ref _; do
  [ "$remote_ref" = "refs/heads/main" ] && pushes_main=1
done
[ "$pushes_main" = 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1
if [ ! -d node_modules ]; then
  if [ -f package-lock.json ]; then npm ci --silent; else npm install --silent; fi
fi
if ! node scripts/check.mjs; then
  echo "New check findings — fix them before pushing; see CHECKS.md"
  exit 1
fi
